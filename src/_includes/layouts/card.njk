<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title }} — oh, no. the truth factory!</title>
  <link rel="stylesheet" href="/assets/styles.css" />
</head>
<body class="page">
  {% include "partials/header.njk" %}

  <main class="container">
    <article class="card-page">
      <section class="flip-wrap">
        <div class="card front">
          <div class="card-image">{{ image | safe }}</div>
          <div class="card-questions">
            {% for q in questions %}
              <div class="q"> {{ loop.index }}. {{ q }}</div>
            {% endfor %}
          </div>
          <div class="flip-note">Click to flip →</div>
        </div>

        <div class="card back">
          <h2 class="card-title">{{ title }}</h2>

          <div class="card-body">
            {{ content | safe }}
          </div>

          <div class="answers">
            {% set body = content | dump %}
            {# We will render answers by looking for a literal "[answers]" in the raw content. #}
            {% set raw = content | safe %}
            {% if raw contains '[answers]' %}
              {% set parts = raw.split('[answers]') %}
              {% set para = parts[0] %}
              {% set answers = parts[1] %}
              <div class="back-paragraphs">
                {{ para | safe }}
              </div>
              <div class="answers-list">
                <h3>Answers</h3>
                <pre class="answers-pre">{{ answers | trim }}</pre>
              </div>
            {% else %}
              <div class="back-paragraphs">{{ content | safe }}</div>
            {% endif %}
          </div>

          <div class="flip-note">Click to flip back</div>
        </div>
      </section>
    </article>
  </main>
</body>
</html>

{% macro cardItem(card) %}
{% set shareUrl = card.url or card.data.url or '' %}
<article class="flip-card" data-share-url="{{ shareUrl }}">
  <button class="share-btn" type="button" aria-label="Share this card" data-share-url="{{ shareUrl }}">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M14 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"></path>
      <path d="M19 10H9a4 4 0 0 0-4 4v1" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
      <path d="M7 4h2" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.8"></path>
    </svg>
  </button>
  <div class="flip-inner">
    <div class="face front">
      <div class="card-image">{{ card.data.image | safe }}</div>
      <div class="meta">
        <div class="card-id">card #{{ card.data.number or card.fileSlug }}</div>
        <h3 class="card-title">{{ card.data.title }}</h3>
      </div>

      <div class="card-questions">
        {% for q in card.data.questions %}
          <div class="q">{{ loop.index }}. {{ q }}</div>
        {% endfor %}
      </div>

      <div class="flip-note">click to flip</div>
    </div>

    <div class="face back">
      <div class="back-head">
        <div class="icon">🔎</div>
        <div>
          <div class="small">answers</div>
          <h3 class="card-title">{{ card.data.title }} — the back</h3>
        </div>
      </div>

      <div class="back-body">
        {{ card.templateContent | safe }}
      </div>

      <div class="flip-note">click to flip back</div>
    </div>
  </div>
</article>
{% endmacro %}
